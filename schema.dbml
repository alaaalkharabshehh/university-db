
Table departments {
  id integer [pk, increment]
  name varchar [not null, unique]
}

Table instructors {
  id integer [pk, increment]
  FullName varchar [not null]
  email varchar [not null, unique]
  department_id integer [not null]
  hired_at date
}

Table students {
  id integer [increment]
  full_name varchar [not null]
  email varchar [not null]
  date_of_birth varchar
  created_at timestamp [default: `now()`]
}

Table courses {
  id integer [pk, increment]
  code varchar [not null, unique]
  title varchar [not null]
  credit_hours varchar
  department_id integer [not null]
  instructor_id integer
  instructor_name varchar
  student_id integer
}

Table enrollments {
  id integer [pk, increment]
  student_id varchar [not null]
  course_id integer [not null]
  enrolled_at timestamp [default: `now()`]
  grade decimal(5,2)
}

Ref: courses.instructor_id > instructors.id
Ref: departments.id > courses.department_id
Ref: enrollments.student_id > students.id
Ref: enrollments.course_id > courses.course_id
